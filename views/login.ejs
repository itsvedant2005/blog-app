<%- include("partials/header") %>

<h2>Login</h2>

<form action="/login" method="POST" class="form">

    <input
        type="email"
        name="email"
        placeholder="Enter Email"
        required
    >

    <input
        type="password"
        name="password"
        placeholder="Enter Password"
        required
    >

    <button type="submit">
        Login
    </button>

</form>

<p style="text-align:center; margin-top:20px;">

    Don't have an account?

    <a href="/register">
        Register
    </a>

</p>

<%- include("partials/footer") %>