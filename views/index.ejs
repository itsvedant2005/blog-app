<%- include("partials/header") %>

<!-- HERO SECTION -->

<section class="hero">

    <div class="hero-content">

        <span class="hero-badge">
            ✍️ A Place For Writers & Creators
        </span>

        <h1>
            Every Great Story Starts
            With One Idea
        </h1>

        <p>
            Publish articles, share experiences,
            and inspire readers around the world.
        </p>

        <div class="hero-buttons">

            <a href="/create" class="hero-btn">
                Start Writing
            </a>

        </div>

    </div>

</section>

<!-- BLOG SECTION -->

<section class="blogs-section">

    <h2>Explore Blogs</h2>

    <!-- CATEGORY FILTER -->

    <div class="category-filter">

        <a href="/">All</a>

        <a href="/search?keyword=Technology">
            Technology
        </a>

        <a href="/search?keyword=Programming">
            Programming
        </a>

        <a href="/search?keyword=Travel">
            Travel
        </a>

        <a href="/search?keyword=Sports">
            Sports
        </a>

        <a href="/search?keyword=Education">
            Education
        </a>

        <a href="/search?keyword=Lifestyle">
            Lifestyle
        </a>

    </div>

    <% if(posts.length === 0){ %>

        <div class="empty">

            No blog posts found.

        </div>

    <% } %>

    <div class="posts">

        <% posts.forEach(post => { %>

            <div class="card">

                <span class="card-category">

                    <%= post.category %>

                </span>

                <h3>

                    <a href="/post/<%= post._id %>">

                        <%= post.title %>

                    </a>

                </h3>

                <div class="card-meta">

                    <span>

                        ✍️ <%= post.author %>

                    </span>

                    <span>

                        📅
                        <%= new Date(post.createdAt).toLocaleDateString() %>

                    </span>

                </div>

                <% if(post.content){ %>

                    <p class="preview">

                        <%= post.content.substring(0,180) %>...

                    </p>

                <% } %>

                <a
                    href="/post/<%= post._id %>"
                    class="read-more"
                >

                    Read More →

                </a>

            </div>

        <% }) %>

    </div>

</section>

<%- include("partials/footer") %>